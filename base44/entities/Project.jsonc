{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "single",
        "ep",
        "album"
      ],
      "default": "single"
    },
    "main_artist_id": {
      "type": "string"
    },
    "main_artist_name": {
      "type": "string"
    },
    "featuring": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "release_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "planejamento",
        "producao",
        "revisao",
        "pre_lancamento",
        "agendado",
        "lancado",
        "pausado",
        "cancelado",
        "arquivado"
      ],
      "default": "rascunho"
    },
    "track_count": {
      "type": "number",
      "default": 0
    },
    "duration": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type",
    "status"
  ]
}